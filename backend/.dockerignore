

# 📦 Version Control
.git
.gitignore

# � Secrets & Environment (Jangan pernah me-nge-bake .env ke dalam image Docker!)
# Di Cloud Run, .env disuplai menggunakan Secret Manager atau Environment Variables.
.env
.env.*


# OS & IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# 🐳 Docker & Deployment (Tidak perlu memasukkan konfigurasi docker ke dalam image)
Dockerfile
docker-compose*
.dockerignore

# ⚙️ Go Local Binaries & Caches (Biar Docker build ulang murni dari source)
bin/
vendor/
*.exe
*.test
*.out

# Local Data & Smart Contracts (Tidak diperlukan oleh Backend Container)
postgres_data/
contracts/
*.log
build/
tmp/
